{
  "name": "artuk-open-glam-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Static site for the Art UK Open GLAM Toolkit, generated from a Twine export and styled for Art UK in partnership with GLAM-E Lab.",
  "type": "module",
  "scripts": {
    "import": "node scripts/import-twine.js",
    "build": "npm run import && eleventy",
    "serve": "npm run import && eleventy --serve",
    "check": "npm run import && node scripts/check-links.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "node-html-parser": "^9.0.4"
  }
}
